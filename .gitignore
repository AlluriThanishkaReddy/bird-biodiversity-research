# ==============================================================================
# Git Ignore Rules: Acoustic Bird Biodiversity Research
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Audio Data & Large Binaries
# (Raw BirdCLEF audio is external at C:/Datasets/birdclef-2024)
*.ogg
*.wav
*.flac
*.mp3
*.m4a
*.aac

# Cached processed features & embeddings
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/manifests/*.csv.gz
data/manifests/*.parquet
!data/manifests/.gitkeep

# Model weights, checkpoints & serialized artifacts
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.pkl

# Experiment logs & profiling outputs
experiments/*
!experiments/.gitkeep
lightning_logs/
wandb/
runs/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
