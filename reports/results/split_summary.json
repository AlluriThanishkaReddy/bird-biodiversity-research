  "stratification_limitations": [
    {
      "limitation": "Extreme Few-Shot Sample Indivisibility",
      "description": "Classes with 5 total recordings (asiope1, integr, niwpig1) cannot be perfectly partitioned at 70.0% / 15.0% / 15.0% (which would require 3.5 / 0.75 / 0.75 recordings). To guarantee that validation and test sets have non-zero true positive support for Macro ROC-AUC evaluation, exactly 3 recordings (60.0%) are allocated to train, 1 recording (20.0%) to validation, and 1 recording (20.0%) to test.",
      "affected_classes_count": 3,
      "mitigation": "1 positive sample guaranteed in val and test for all classes."
    },
    {
      "limitation": "Cross-Species Recording Identifier Binding",
      "description": "19 distinct Xeno-Canto recordings (38 rows in metadata) appear in multiple species directories due to multi-species vocalizations in the source audio. To prevent recording-level data leakage, both species instances of each shared recording are strictly locked into the same split.",
      "affected_recordings_count": 19,
      "mitigation": "Atomic grouping by recording_id eliminates cross-split data leakage."
    },
    {
      "limitation": "Author-Level Stratification Impossibility",
      "description": "A single author (e.g. Jos\u00e9 Carlos Sires) contributed 915 recordings spanning over 100 species. Grouping splits by author makes species stratification mathematically impossible, resulting in complete class absence (0 samples) for rare species in validation folds. Therefore, grouping is strictly enforced at the recording level rather than author level.",
      "affected_recordings_count": 24459,
      "mitigation": "Recording-level isolation prevents acoustic file leakage while maintaining 100% species coverage."
    },
    {
      "limitation": "Secondary Label Co-occurrence Multi-label Drift",
      "description": "Recordings with secondary labels contain incidental bird vocalizations that cannot be jointly optimized with primary labels under standard single-target stratification.",
      "affected_recordings_count": 1892,
      "mitigation": "Stratification optimizes primary species targets while preserving realistic background co-occurrences."
    }
  ],
